# ============================================
# Backend Environment Variables (Server-Side)
# These are used by Vercel Serverless Functions
# ============================================

# Firebase Service Account (Server Admin SDK)
# Get this from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Paste the entire JSON content as a single line or use Vercel Environment Variables
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
FIREBASE_PROJECT_ID=your_project_id

# OpenWeather API Key (Server-Side)
# Same as client-side, but required for server functions
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Cron Secret for Security
# Generate a random string to protect your API endpoints
# You can generate one with: openssl rand -base64 32
CRON_SECRET=your_random_secret_string_here

# ============================================
# Vercel-Specific Variables
# ============================================
# These are automatically set by Vercel, but listed for reference
# VERCEL_URL=your-project.vercel.app
# VERCEL_ENV=production
# NODE_ENV=production
